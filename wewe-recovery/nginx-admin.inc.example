# Public management shell. WeWeRSS protects management APIs with its AuthCode.
# Do not enable HTTP Basic here: both mechanisms use the Authorization header.
location = /dash {
    return 302 /dash/;
}

location ^~ /dash/ {
    limit_except GET HEAD {
        deny all;
    }

    proxy_pass http://127.0.0.1:14000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization "";
    proxy_set_header Accept-Encoding "";
    sub_filter_once off;
    sub_filter "window.__WEWE_RSS_SERVER_ORIGIN_URL__ = 'http://127.0.0.1:14000';"
               "window.__WEWE_RSS_SERVER_ORIGIN_URL__ = 'https://rss.kongye.site';";
    sub_filter 'http://127.0.0.1:14000/favicon.ico' '/favicon.ico';
    proxy_connect_timeout 10s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    limit_conn perip 5;
}

location = /favicon.ico {
    proxy_pass http://127.0.0.1:14000;
    proxy_set_header Authorization "";
    limit_conn perip 5;
}

location ^~ /trpc/ {
    limit_except GET POST OPTIONS {
        deny all;
    }

    proxy_pass http://127.0.0.1:14000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $http_authorization;
    proxy_connect_timeout 10s;
    proxy_send_timeout 1200s;
    proxy_read_timeout 1200s;
    limit_conn perip 5;
}
