[Unit]
Description=WeWeRSS login recovery monitor
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/wewe-rss/recovery
EnvironmentFile=/opt/wewe-rss/recovery/recovery.env
ExecStart=/usr/bin/python3 /opt/wewe-rss/recovery/monitor.py
TimeoutStartSec=25min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/wewe-rss/recovery

[Install]
WantedBy=multi-user.target
