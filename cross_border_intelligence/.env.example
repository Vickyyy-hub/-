ARK_API_KEY=
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/responses
AI_MODEL=doubao-seed-2-0-mini-260215

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
# 四个 Table ID 均为可选；留空时按“跨境-...”表名查找或创建。
FEISHU_SOURCE_TABLE_ID=
FEISHU_SIGNAL_TABLE_ID=
FEISHU_PROFILE_TABLE_ID=
FEISHU_DIRECTION_TABLE_ID=

# 可选；未配置时跳过 Mercado Libre，不影响其他来源。
MERCADOLIBRE_ACCESS_TOKEN=
# 可选；eBay Browse API 还需要先在配置中设定品类/关键词种子。
EBAY_ACCESS_TOKEN=

STATE_DB=.state/market_intelligence.sqlite
